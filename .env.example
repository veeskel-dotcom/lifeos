# LifeOS — Environment Variables
# Скопируйте в .env и заполните значения

# OpenRouter API (AI-ассистент, OCR, vision)
# Получить: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# FatSecret API (поиск продуктов питания) — опционально
# Получить: https://platform.fatsecret.com
VITE_FATSECRET_CLIENT_ID=
VITE_FATSECRET_CLIENT_SECRET=
